<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- TFMのWindowsバージョンがそのまま最低OS要件にならないよう、AppxManifestのMinVersionに合わせる -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ターゲットランタイム -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- .NETランタイムはMSIXフレームワークパッケージとして配布されておらず、ストア経由でも自動導入されない。
         フレームワーク依存だと初回起動時にランタイム導入を促されるため、自己完結で発行する -->
    <SelfContained>true</SelfContained>
    <!-- アプリのアイコンをMSIXにも設定 -->
    <ApplicationIcon>Assets/logo.ico</ApplicationIcon>
    <!-- 自己完結発行だとWPFの各国語リソースまで同梱される。アプリUIは英語なので、
         TextBoxの右クリックメニュー等がWindowsの言語に追従する ja だけ残して他は落とす -->
    <SatelliteResourceLanguages>en;ja</SatelliteResourceLanguages>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- ビルド時にコピー -->
    <!-- マニフェスト -->
    <None Include="AppxManifest.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <!-- <CopyToPublishDirectory>Always</CopyToPublishDirectory> -->
    </None>
    <!-- アイコン -->
    <Content Include="Assets\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <!-- <CopyToPublishDirectory>Always</CopyToPublishDirectory> -->
    </Content>

    <!-- アプリ左上のアイコン -->
    <Resource Include="Assets/logo.ico" />

  </ItemGroup>


</Project>
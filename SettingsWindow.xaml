<Window x:Class="ParallelScope.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ParallelScope.Utilities"
        Title="{loc:Loc Settings.Title}" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Icon="Assets/logo.ico"
        FontFamily="Segoe UI Variable Text">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側: 設定カテゴリのメニュー。選択に応じて右側のパネルを切り替える -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="4" Margin="0,0,10,0">
                <ListBox Name="SettingsMenuListBox" BorderThickness="0" Background="Transparent"
                         SelectionChanged="SettingsMenuListBox_SelectionChanged">
                    <ListBoxItem Name="RootFoldersMenuItem" Content="{loc:Loc Settings.Menu.RootFolders}" IsSelected="True" Padding="8,6"/>
                    <ListBoxItem Name="TreeNodesMenuItem" Content="{loc:Loc Settings.Menu.TreeNodes}" Padding="8,6"/>
                    <ListBoxItem Name="ColumnsMenuItem" Content="{loc:Loc Settings.Menu.Columns}" Padding="8,6"/>
                    <ListBoxItem Name="ThemeMenuItem" Content="{loc:Loc Settings.Menu.Theme}" Padding="8,6"/>
                    <ListBoxItem Name="LanguageMenuItem" Content="{loc:Loc Settings.Menu.Language}" Padding="8,6"/>
                    <ListBoxItem Name="SubscriptionMenuItem" Content="{loc:Loc Settings.Menu.Subscription}" Padding="8,6"/>
                    <ListBoxItem Name="SupportMenuItem" Content="{loc:Loc Settings.Menu.Support}" Padding="8,6"/>
                </ListBox>
            </Border>

            <!-- 右側: ルート追加/削除・除外・スキャン間隔のページ -->
            <Grid Grid.Column="1" Name="RootSettingsPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Settings.Root.Header}" Style="{StaticResource PaneHeaderTextStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="8">
                    <ListBox Name="RootPathsListBox"/>
                </Border>

                <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Name="NewRootPathTextBox" Height="28" VerticalContentAlignment="Center"/>
                    <!-- ボタン幅は言語によって必要な幅が変わるため、既定幅を下限にして文字に合わせて伸びるようにする -->
                    <Button Grid.Column="1" Content="{loc:Loc Common.Add}" MinWidth="72" Padding="8,0" Margin="8,0,0,0" Click="AddRootPathButton_Click"/>
                    <Button Grid.Column="2" Content="{loc:Loc Common.Remove}" MinWidth="72" Padding="8,0" Margin="8,0,0,0" Click="RemoveRootPathButton_Click"/>
                    <Button Grid.Column="3" Content="{loc:Loc Common.Up}" MinWidth="60" Padding="8,0" Margin="8,0,0,0" Click="MoveRootPathUpButton_Click"/>
                    <Button Grid.Column="4" Content="{loc:Loc Common.Down}" MinWidth="60" Padding="8,0" Margin="8,0,0,0" Click="MoveRootPathDownButton_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Text="{loc:Loc Settings.Root.Interval}"/>
                    <TextBox Grid.Column="1" Name="FullScanIntervalHoursTextBox" Margin="8,0,8,0" Height="28" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{loc:Loc Settings.Root.IntervalUnit}"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="4" Text="{loc:Loc Settings.Root.Excluded}" Style="{StaticResource PaneHeaderTextStyle}" Margin="0,12,0,8"/>

                <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Padding="8">
                    <ListBox Name="ExcludedPathsListBox"/>
                </Border>

                <Border Grid.Row="6" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Name="NewExcludedPathTextBox" Height="28" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="{loc:Loc Common.Add}" MinWidth="72" Padding="8,0" Margin="8,0,0,0" Click="AddExcludedPathButton_Click"/>
                        <Button Grid.Column="2" Content="{loc:Loc Common.Remove}" MinWidth="72" Padding="8,0" Margin="8,0,0,0" Click="RemoveExcludedPathButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右側: フォルダツリー最上位のノードのカスタマイズのページ -->
            <Grid Grid.Column="1" Name="TreeNodeSettingsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Settings.TreeNodes.Header}" Style="{StaticResource PaneHeaderTextStyle}"/>

                <!-- Plus未購読時のみ表示するアンロック案内。購入操作はSubscriptionページに集約し、ここからは遷移のみ -->
                <Border Grid.Row="1" Name="TreeNodesPlusUpsellCard" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Plus.Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="{loc:Loc Settings.TreeNodes.PlusUpsell}"/>
                        <Button Name="GoToSubscriptionFromTreeNodesButton" Content="{loc:Loc Settings.GoToSubscription}" HorizontalAlignment="Left"
                                Padding="8,6" Click="GoToSubscriptionButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- 未購読時はIsEnabled=falseで薄字表示・操作不可にする（WPFの無効化スタイルに任せる） -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12" VerticalAlignment="Top">
                    <StackPanel Name="TreeNodeCheckBoxesPanel">
                        <TextBlock Text="{loc:Loc Settings.TreeNodes.Description}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc Settings.TreeNodes.Note}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 並びがそのままツリー最上位の並び順になる（項目は表示列と同じ ColumnOptionViewModel） -->
                            <ListBox Grid.Column="0" Name="TreeNodeOrderListBox" Height="160">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggleVisibility}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Button Content="{loc:Loc Common.Up}" MinWidth="80" Padding="8,6" Click="MoveTreeNodeUpButton_Click"/>
                                <Button Content="{loc:Loc Common.Down}" MinWidth="80" Margin="0,8,0,0" Padding="8,6" Click="MoveTreeNodeDownButton_Click"/>
                            </StackPanel>
                        </Grid>

                        <Button Name="ResetTreeNodesButton" Content="{loc:Loc Settings.TreeNodes.Reset}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Padding="8,6" Click="ResetTreeNodesButton_Click"/>
                        <TextBlock Name="ResetTreeNodesHintTextBlock" Visibility="Collapsed" TextWrapping="Wrap"
                                   Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Loc Settings.TreeNodes.ResetHint}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右側: ファイル一覧の表示列カスタマイズのページ。
                 未購読時はアンロック案内が増えてウィンドウの高さに収まらなくなるため、カードはスクロール領域に入れる
                 （固定サイズのウィンドウなので、収まらないと下のカードが見えなくなってしまう） -->
            <Grid Grid.Column="1" Name="ColumnSettingsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Settings.Columns.Header}" Style="{StaticResource PaneHeaderTextStyle}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <!-- Plus未購読時のみ表示するアンロック案内。購入操作はSubscriptionページに集約し、ここからは遷移のみ -->
                    <Border Name="PlusUpsellCard" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Plus.Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="{loc:Loc Settings.Columns.PlusUpsell}"/>
                            <Button Name="GoToSubscriptionButton" Content="{loc:Loc Settings.GoToSubscription}" HorizontalAlignment="Left"
                                    Padding="8,6" Click="GoToSubscriptionButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 未購読時はIsEnabled=falseで薄字表示・操作不可にする（WPFの無効化スタイルに任せる） -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" VerticalAlignment="Top">
                        <StackPanel Name="ColumnCheckBoxesPanel">
                            <TextBlock Text="{loc:Loc Settings.Columns.Description}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Settings.Columns.Note}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 並びがそのままファイル一覧の列順になる（項目は ColumnOptionItem） -->
                                <ListBox Grid.Column="0" Name="ColumnOrderListBox" Height="240">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanToggleVisibility}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <Button Content="{loc:Loc Common.Up}" MinWidth="80" Padding="8,6" Click="MoveColumnUpButton_Click"/>
                                    <Button Content="{loc:Loc Common.Down}" MinWidth="80" Margin="0,8,0,0" Padding="8,6" Click="MoveColumnDownButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- 列幅はこの画面では編集できない（ヘッダーのドラッグで変わる）ため、まとめて既定に戻す手段を置く -->
                            <Button Name="ResetColumnsButton" Content="{loc:Loc Settings.Columns.Reset}" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Padding="8,6" Click="ResetColumnsButton_Click"/>
                            <TextBlock Name="ResetColumnsHintTextBlock" Visibility="Collapsed" TextWrapping="Wrap"
                                       Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{loc:Loc Settings.Columns.ResetHint}"/>
                        </StackPanel>
                    </Border>

                    <!-- 隠し・システム属性の表示。列の設定と違い無料版でも使えるため、購読状態では出し分けない -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,10,0,0" VerticalAlignment="Top">
                        <StackPanel Name="HiddenItemsPanel">
                            <TextBlock Text="{loc:Loc Settings.HiddenItems.Header}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Loc Settings.HiddenItems.Description}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                            <CheckBox Name="ShowHiddenItemsCheckBox" Content="{loc:Loc Settings.HiddenItems.ShowHidden}"/>
                            <CheckBox Name="ShowSystemItemsCheckBox" Content="{loc:Loc Settings.HiddenItems.ShowSystem}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 右側: 配色テーマのページ。切り替えは即座に適用・保存されるためSave/Cancelボタンは出さない -->
            <Grid Grid.Column="1" Name="ThemePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Settings.Theme.Header}" Style="{StaticResource PaneHeaderTextStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.Theme.Description}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Tagの値はAppTheme.Parseでそのまま解釈する -->
                        <RadioButton Name="SystemThemeRadioButton" GroupName="Theme" Tag="System"
                                     Content="{loc:Loc Settings.Theme.System}" Checked="ThemeRadioButton_Checked"/>
                        <RadioButton Name="LightThemeRadioButton" GroupName="Theme" Tag="Light"
                                     Content="{loc:Loc Settings.Theme.Light}" Margin="0,8,0,0" Checked="ThemeRadioButton_Checked"/>
                        <RadioButton Name="DarkThemeRadioButton" GroupName="Theme" Tag="Dark"
                                     Content="{loc:Loc Settings.Theme.Dark}" Margin="0,8,0,0" Checked="ThemeRadioButton_Checked"/>

                        <TextBlock Text="{loc:Loc Settings.Theme.Note}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右側: 表示言語のページ。配色テーマと同じく、切り替えは即座に適用・保存されるためSave/Cancelボタンは出さない。
                 無料版でも使える機能のため、Plusの購読状態では制限しない -->
            <Grid Grid.Column="1" Name="LanguagePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Settings.Language.Header}" Style="{StaticResource PaneHeaderTextStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Settings.Language.Description}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Tagの値はAppLanguage.Parseでそのまま解釈する -->
                        <RadioButton Name="SystemLanguageRadioButton" GroupName="Language" Tag="System"
                                     Content="{loc:Loc Settings.Language.System}" Checked="LanguageRadioButton_Checked"/>
                        <RadioButton Name="EnglishLanguageRadioButton" GroupName="Language" Tag="English"
                                     Content="{loc:Loc Settings.Language.English}" Margin="0,8,0,0" Checked="LanguageRadioButton_Checked"/>
                        <RadioButton Name="JapaneseLanguageRadioButton" GroupName="Language" Tag="Japanese"
                                     Content="{loc:Loc Settings.Language.Japanese}" Margin="0,8,0,0" Checked="LanguageRadioButton_Checked"/>

                        <TextBlock Text="{loc:Loc Settings.Language.Note}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右側: Plusサブスクリプションの案内・購入・解約のページ -->
            <Grid Grid.Column="1" Name="SubscriptionPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Settings.Subscription.Header}" Style="{StaticResource PaneHeaderTextStyle}"/>

                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Plus.Name}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <!-- 購読済みの場合のみ表示する状態表示 -->
                            <TextBlock Name="PlusActiveTextBlock" Text="{loc:Loc Settings.Subscription.Active}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="{loc:Loc Settings.Subscription.Description}"/>
                            <!-- 価格を取得できたら、コードビハインドが金額入りの文言へ差し替える -->
                            <Button Name="SubscribePlusButton" Content="{loc:Loc Settings.Subscription.Subscribe}" HorizontalAlignment="Left"
                                    Padding="8,6" Click="SubscribePlusButton_Click"/>
                            <TextBlock Name="PlusStatusTextBlock" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="{loc:Loc Settings.Subscription.ManageDescription}"/>
                            <Button Name="ManageSubscriptionButton" Content="{loc:Loc Settings.Subscription.Manage}" HorizontalAlignment="Left"
                                    Padding="8,6" Click="ManageSubscriptionButton_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 右側: 開発者サポートページへのリンクのページ -->
            <Grid Grid.Column="1" Name="SupportPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc Settings.Support.Header}" Style="{StaticResource PaneHeaderTextStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Settings.Support.Body}"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,12,0,12" Text="{loc:Loc Settings.Support.Note}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Button Name="KofiButton" Content="{loc:Loc Settings.Support.Kofi}" HorizontalAlignment="Left"
                                Padding="8,6" Click="KofiButton_Click"/>
                        <Button Name="GitHubSponsorsButton" Content="{loc:Loc Settings.Support.GitHubSponsors}" HorizontalAlignment="Left"
                                Padding="8,6" Margin="0,8,0,0" Click="GitHubSponsorsButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- フルスキャンが意味を持つのはルート/除外設定のみのため、Display Columnsページでは非表示にする -->
            <Button Name="SaveAndFullScanButton" Content="{loc:Loc Settings.SaveAndFullScan}" MinWidth="130" Padding="8,0" Margin="0,0,8,0" Click="SaveAndFullScanButton_Click"/>
            <!-- Supportページには保存対象の設定がないため、Save/Cancelボタンは非表示にする -->
            <Button Name="SaveButton" Content="{loc:Loc Common.Save}" MinWidth="90" Padding="8,0" IsDefault="True" Click="SaveButton_Click"/>
            <Button Name="CancelButton" Content="{loc:Loc Common.Cancel}" MinWidth="90" Padding="8,0" Margin="0,0,8,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

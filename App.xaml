<Application x:Class="ParallelScope.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ParallelScope"
             StartupUri="MainWindow.xaml"
             ThemeMode="System">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 選択行・タブ・トグルON状態の面の色。アクセント色を敷くと薄い水色が主張して古びて見えるため、
                 面はテーマ追従のニュートラル（本文色を薄く敷いたグレー）にし、ONであることは
                 面の濃さと太字で示す（アクセント色の文字も青が強く出るため使わない）。
                 TextFillColorPrimary は明暗テーマで反転するので、
                 ライトではグレー、ダークでは白の薄敷きになり、どちらでも面が沈まない -->
            <SolidColorBrush x:Key="SelectionNeutralFillBrush"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.14"/>
            <SolidColorBrush x:Key="SelectionNeutralHoverFillBrush"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.06"/>
            <SolidColorBrush x:Key="SelectionNeutralPressedFillBrush"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.14"/>

            <!-- Fluent既定のトグルON状態（アクセント色べた塗り＋反転文字）を上の面色に差し替える。
                 文字色はテンプレートが直接指定してくるため、各トグルのContent側で
                 ToggleButtonContentTextStyle を使って上書きする -->
            <!-- 別名（<StaticResource x:Key=.../>）で束ねると DynamicResource 参照側でブラシとして
                 解決されず、Fluent既定のアクセント色に戻ってしまうため、キーごとに実体を定義する -->
            <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.14"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.14"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.20"/>
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.10"/>

            <!-- トグルの中身。ONのときは太字にするだけで、文字色は通常のまま（色を足さず濃淡で示す）。
                 Fluent既定のテンプレートはON時に文字色を反転させてくるため、ここで戻している -->
            <Style x:Key="ToggleButtonContentTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- ツリーの選択・ホバーの濃さを、一覧の選択行やタブと揃える
                 （Fluent既定は薄すぎて、同じ画面の他の選択表示と釣り合わない） -->
            <SolidColorBrush x:Key="TreeViewItemBackgroundSelected"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.14"/>
            <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.06"/>

            <!-- Fluent既定はフォーカス中のテキストボックスの下線とツリー選択の目印をアクセント色（濃い青）で描く。
                 青を画面から無くすため、どちらも本文色を薄く敷いたグレーに差し替える -->
            <SolidColorBrush x:Key="TextControlFocusedBorderBrush"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.55"/>
            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.55"/>
            <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground"
                             Color="{DynamicResource TextFillColorPrimary}" Opacity="0.55"/>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="5"/>
                <!-- SystemColors はWindowsのダークモードに追従せず常にライト配色（白背景）を返すため、
                     Fluentテーマのブラシキーを使う。SurfaceStrokeColorDefaultBrush は
                     ライト/ダーク共通の半透明グレーで、どちらでも枠線が視認できる -->
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="PaneHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="SubtleStatusTextStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.8"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
    
</Application>

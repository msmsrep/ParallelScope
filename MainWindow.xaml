<Window x:Class="ParallelScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParallelScope"
        xmlns:loc="clr-namespace:ParallelScope.Utilities"
        mc:Ignorable="d"
        Title="ParallelScope" Height="600" Width="1000"
        MinWidth="560" MinHeight="400"
        Icon="Assets/logo.ico"
        FontFamily="Segoe UI Variable Text">

    <!-- タイトルバーを自前で描いてメニューを載せる（メニュー専用の行をなくして縦幅を稼ぐため）。
         WPFにはタイトルバーへ内容を差し込むAPIが無いので、WindowChromeで非クライアント領域を
         クライアント側へ取り込み、キャプションボタンも自前のボタンで用意する。
         CaptionHeight はタイトルバー行の高さと必ず揃えること（ドラッグ・ダブルクリックの当たり判定になる） -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- キャプションボタン。Fluent既定のButtonは角丸・余白付きでWindows標準の見た目と合わないため、
             専用テンプレートで描き直す。ホバー時の背景色は Tag から取る（閉じるボタンだけ赤にするため） -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Tag" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <!-- アイコンフォント。Windows 10には Segoe Fluent Icons が無いためMDL2へフォールバックする -->
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="ButtonBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 閉じるボタンだけホバーで赤くする。赤地では文字色を白に固定する（配色テーマに依らず読めるように） -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Tag" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="ButtonBackground" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="ButtonBackground" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- タイトルバーのメニューボタン。キャプションボタンと同じ塗り方だが、
             文字を載せるので幅は内容なり・角丸ありにする -->
        <Style x:Key="TitleBarMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="ButtonBackground" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最大化/元に戻すは状態でアイコンとツールチップが入れ替わる。
             表示言語の切り替えにも追従させたいので、コードではなくトリガーで差し替える -->
        <Style x:Key="MaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Content" Value="&#xE922;"/>
            <Setter Property="ToolTip" Value="{loc:Loc TitleBar.Maximize}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;"/>
                    <Setter Property="ToolTip" Value="{loc:Loc TitleBar.Restore}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー。高さはWindowChromeのCaptionHeightと揃える。
             ここに置くコントロールには WindowChrome.IsHitTestVisibleInChrome="True" が要る
             （付けないとウィンドウのドラッグ領域に吸われてクリックできない） -->
        <Grid Grid.Row="0" Height="36" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ロゴ。IsHitTestVisibleInChrome を付けないのは意図的で、
                 押しどころではなくウィンドウのドラッグ領域のままにするため -->
            <Image Grid.Column="0" Source="Assets/icon-44.png" Width="20" Height="20"
                   Margin="10,0,0,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- メニューは Menu/MenuItem ではなくボタン＋ContextMenu で出す。
                 FluentテーマのMenuItemは内側の余白が固定（枠4px＋内容10px）で高さ50px程度を要求し、
                 36pxのタイトルバーに置くと文字が潰れて読めなくなるため -->
            <Button Grid.Column="1" x:Name="TitleBarMenuButton" Style="{StaticResource TitleBarMenuButtonStyle}"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="TitleBarMenuButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Loc Menu}" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" VerticalAlignment="Center" Margin="8,1,0,0" FontSize="8"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Loc Menu.Settings}" Click="OpenSettingsMenuItem_Click"/>
                        <Separator/>
                        <!-- Plus機能。未購読時もメニューは出すが、薄字で押せない状態にする
                             （購読状態が分かる前に押せてしまわないよう既定は無効） -->
                        <MenuItem Name="ExportCsvMenuItem" Header="{loc:Loc Menu.ExportCsv}"
                                  IsEnabled="False" Click="ExportCsvMenuItem_Click"/>
                        <Separator/>
                        <!-- Plus機能。CSV書き出しと同じく、未購読時は薄字で選べない状態にする -->
                        <MenuItem Name="SplitViewMenuItem" Header="{loc:Loc Menu.SplitView}" IsCheckable="True"
                                  IsEnabled="False" Click="SplitViewMenuItem_Click"/>
                        <MenuItem Name="SplitVerticalMenuItem" Header="{loc:Loc Menu.SplitVertical}" IsCheckable="True"
                                  IsChecked="True" IsEnabled="False" Click="SplitOrientationMenuItem_Click"/>
                        <MenuItem Name="SplitHorizontalMenuItem" Header="{loc:Loc Menu.SplitHorizontal}" IsCheckable="True"
                                  IsEnabled="False" Click="SplitOrientationMenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="{loc:Loc Menu.UserGuide}" Click="OpenUserGuideMenuItem_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- アプリ名＋バージョン。非アクティブ時はWindows標準に倣って薄く表示する -->
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,12,0"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;"
                        ToolTip="{loc:Loc TitleBar.Minimize}" Click="MinimizeButton_Click"/>
                <Button Style="{StaticResource MaximizeButtonStyle}" Click="MaximizeRestoreButton_Click"/>
                <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;"
                        ToolTip="{loc:Loc TitleBar.Close}" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- 閲覧ペイン（ツリー＋ファイル一覧）の置き場。
             2画面表示（分割）ではここに2つ目のペインが並ぶため、XAMLに直接置かずコードから追加する -->
        <Grid Grid.Row="1" Name="PaneHost" Margin="5,3,5,5"/>
    </Grid>
</Window>

<Window x:Class="ParallelScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParallelScope"
        xmlns:loc="clr-namespace:ParallelScope.Utilities"
        mc:Ignorable="d"
        Title="ParallelScope" Height="600" Width="1000"
        MinWidth="560" MinHeight="400"
        Icon="Assets/logo.ico"
        FontFamily="Segoe UI Variable Text">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource CardBorderStyle}">
            <Menu HorizontalAlignment="Left">
                <MenuItem Header="{loc:Loc Menu}">
                    <MenuItem Header="{loc:Loc Menu.Settings}" Click="OpenSettingsMenuItem_Click"/>
                    <Separator/>
                    <!-- Plus機能。未購読時もメニューは出すが、薄字で押せない状態にする
                         （購読状態が分かる前に押せてしまわないよう既定は無効） -->
                    <MenuItem Name="ExportCsvMenuItem" Header="{loc:Loc Menu.ExportCsv}"
                              IsEnabled="False" Click="ExportCsvMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="{loc:Loc Menu.UserGuide}" Click="OpenUserGuideMenuItem_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- 閲覧ペイン（ツリー＋ファイル一覧）の置き場。
             2画面表示（分割）ではここに2つ目のペインが並ぶため、XAMLに直接置かずコードから追加する -->
        <Grid Grid.Row="1" Name="PaneHost"/>
    </Grid>
</Window>
